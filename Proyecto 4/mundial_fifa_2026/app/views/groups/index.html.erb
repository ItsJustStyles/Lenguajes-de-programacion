<%# ─────────────────────────────────────────────────────────────────────────
    groups/index.html.erb
    Lista de los 12 grupos con sus selecciones y acciones CRUD.
    Variable: @groups
──────────────────────────────────────────────────────────────────────────── %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Grupos del Torneo</h1>
  <%= link_to "＋ Nuevo grupo", new_group_path, class: "btn btn-primary" %>
</div>

<% if @groups.empty? %>
  <div class="alert alert-info">
    No hay grupos registrados. <%= link_to "Crear el primer grupo", new_group_path %>.
  </div>

<% else %>
  <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
    <% @groups.each do |group| %>
      <div class="col">
        <div class="card shadow-sm h-100">

          <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Grupo <%= group.name %></h5>
            <div class="d-flex gap-1">
              <%= link_to "Ver", group_path(group), class: "btn btn-sm btn-outline-light" %>
              <%= link_to "Editar", edit_group_path(group), class: "btn btn-sm btn-outline-warning" %>
              <%= button_to "Eliminar", group_path(group), method: :delete,
                    class: "btn btn-sm btn-outline-danger",
                    data: { turbo_confirm:
                      "¿Eliminar el Grupo #{group.name} y todas sus selecciones y partidos?" } %>
            </div>
          </div>

          <ul class="list-group list-group-flush">
            <% if group.teams.empty? %>
              <li class="list-group-item text-muted fst-italic">Sin selecciones</li>
            <% else %>
              <% group.standings.each do |team| %>
                <li class="list-group-item d-flex justify-content-between align-items-center
                           <%= 'list-group-item-success' if team.qualified? %>
                           <%= 'list-group-item-danger' if team.eliminated? %>">
                  <span>
                    <%= link_to team.name, team_path(team), class: "text-decoration-none fw-semibold" %>
                    <% if team.qualified? %>
                      <span class="badge bg-success ms-1">✓</span>
                    <% elsif team.eliminated? %>
                      <span class="badge bg-danger ms-1">✗</span>
                    <% end %>
                  </span>
                  <span class="badge bg-dark rounded-pill"><%= team.points %> pts</span>
                </li>
              <% end %>
            <% end %>
          </ul>

          <div class="card-footer text-muted small">
            <%= group.teams.count %> / 4 selecciones
            &bull;
            <%= group.matches.count(&:completed?) %> / <%= group.matches.count %> partidos jugados
          </div>

        </div>
      </div>
    <% end %>
  </div>
<% end %>
