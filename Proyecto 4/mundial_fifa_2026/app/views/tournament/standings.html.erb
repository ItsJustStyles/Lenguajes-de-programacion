<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
  <div>
    <h1 class="mb-0">⚽ Fase de Grupos</h1>

    <small class="text-muted">
      Estado:
      <% if @status.current_phase == :not_started %>
        <span class="badge bg-secondary">No iniciado</span>
      <% elsif @status.current_phase == :group_stage %>
        <span class="badge bg-primary">Fase de grupos en curso</span>
      <% elsif @status.current_phase == :knockout %>
        <span class="badge bg-success">Fase eliminatoria</span>
      <% elsif @status.current_phase == :finished %>
        <span class="badge bg-warning text-dark">¡Torneo finalizado!</span>
      <% end %>
    </small>
  </div>

  <div class="d-flex flex-wrap gap-2">
    <% unless @status.group_stage_started? %>
      <%= button_to(
            "⚙️ Generar partidos de grupos (72)",
            tournament_generate_groups_path,
            method: :post,
            class: "btn btn-primary",
            data: { turbo_confirm: "¿Generar los 72 partidos de la fase de grupos?" }
          ) %>
    <% end %>

    <%= button_to(
      "⚡ Autocompletar torneo",
      tournament_autocomplete_path,
      method: :post,
      class: "btn btn-danger",
      data: { turbo_confirm: "Esto registrará automáticamente resultados hasta terminar el torneo. ¿Continuar?" }
    ) %>

    <% if @status.ready_for_knockout? %>
      <%= button_to(
            "🏆 Generar cuadro eliminatorio",
            tournament_generate_bracket_path,
            method: :post,
            class: "btn btn-success",
            data: { turbo_confirm: "¿Calcular los 32 clasificados y generar el cuadro de dieciseisavos?" }
          ) %>
    <% end %>

    <% if @status.knockout_started? %>
      <%= link_to "Ver cuadro eliminatorio →", tournament_bracket_path, class: "btn btn-outline-success" %>
    <% end %>

    <% if @status.finished? %>
      <%= link_to "🏆 Ver campeón", tournament_champion_path, class: "btn btn-warning" %>
    <% end %>
  </div>
</div>

<% if @groups.empty? %>
  <div class="alert alert-info">
    No hay grupos configurados.
    <%= link_to "Crear grupos", new_group_path %>
    para comenzar.
  </div>
<% else %>
  <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
    <% @groups.each do |group| %>
      <div class="col">
        <div class="card shadow-sm h-100">
          <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Grupo <%= group.name %></h5>
            <%= link_to "Detalle", group_path(group), class: "btn btn-sm btn-outline-light" %>
          </div>

          <div class="card-body p-0">
            <table class="table table-sm table-hover standings-table mb-0">
              <thead class="table-secondary">
                <tr>
                  <th>#</th>
                  <th>Selección</th>
                  <th class="text-center" title="Partidos jugados">PJ</th>
                  <th class="text-center" title="Victorias">G</th>
                  <th class="text-center" title="Empates">E</th>
                  <th class="text-center" title="Derrotas">P</th>
                  <th class="text-center" title="Diferencia de goles">DG</th>
                  <th class="text-center fw-bold" title="Puntos">Pts</th>
                </tr>
              </thead>

              <tbody>
                <% group.standings.each do |team| %>
                  <% row_class = "" %>
                  <% row_class += "row-qualified" if team.qualified? %>
                  <% row_class += " row-eliminated" if team.eliminated? %>

                  <tr class="<%= row_class %>">
                    <td class="text-muted"><%= team.group_position || "–" %></td>

                    <td>
                      <%= link_to team.name, team_path(team), class: "text-decoration-none fw-semibold" %>

                      <% if team.qualified? %>
                        <span class="badge bg-success ms-1" title="Clasificado">✓</span>
                      <% elsif team.eliminated? %>
                        <span class="badge bg-danger ms-1" title="Eliminado">✗</span>
                      <% end %>
                    </td>

                    <td class="text-center"><%= team.matches_played %></td>
                    <td class="text-center"><%= team.wins %></td>
                    <td class="text-center"><%= team.draws %></td>
                    <td class="text-center"><%= team.losses %></td>
                    <td class="text-center"><%= team.goal_difference %></td>
                    <td class="text-center fw-bold"><%= team.points %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <% if @status.group_stage_started? %>
            <% group_matches = group.matches.includes(:home_team, :away_team).ordered %>

            <% if group_matches.any? %>
              <div class="card-footer p-2 group-matches">
                <% group_matches.each do |match| %>
                  <div class="match-row d-flex justify-content-between align-items-center py-1 <%= 'border-bottom' unless match == group_matches.last %>">
                    <span class="text-truncate" style="max-width:38%">
                      <%= match.home_team&.name || "TBD" %>
                    </span>

                    <% if match.completed? %>
                      <strong class="px-1">
                        <%= match.home_goals %>–<%= match.away_goals %>
                      </strong>
                    <% else %>
                      <%= link_to "Registrar", edit_match_path(match), class: "btn btn-primary btn-sm py-0 px-2" %>
                    <% end %>

                    <span class="text-truncate text-end" style="max-width:38%">
                      <%= match.away_team&.name || "TBD" %>
                    </span>
                  </div>
                <% end %>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <% if @status.knockout_started? || @status.ready_for_knockout? %>
    <div class="mt-4 d-flex gap-3 small text-muted">
      <span><span class="badge bg-success">✓</span> Clasificado</span>
      <span><span class="badge bg-danger">✗</span> Eliminado</span>
    </div>
  <% end %>
<% end %>