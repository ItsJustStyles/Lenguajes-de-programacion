<!DOCTYPE html>
<html lang="es">
  <head>
    <title>Mundial FIFA 2026</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-light">

    <!-- Barra de navegación principal -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
      <div class="container">
        <%= link_to "⚽ Mundial FIFA 2026", root_path, class: "navbar-brand fw-bold fs-5" %>

        <button class="navbar-toggler" type="button"
                data-bs-toggle="collapse" data-bs-target="#navMenu"
                aria-controls="navMenu" aria-expanded="false" aria-label="Menú">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navMenu">
          <ul class="navbar-nav ms-auto gap-1">
            <li class="nav-item">
              <%= link_to "Dashboard", tournament_standings_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Grupos", groups_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Selecciones", teams_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Partidos", matches_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Cuadro", tournament_bracket_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "🏆 Campeón", tournament_champion_path, class: "nav-link" %>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <!-- Contenido principal -->
    <div class="container my-4">
      <%# Flash de éxito %>
      <% if notice %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
      <% end %>

      <%# Flash de error / advertencia %>
      <% if alert %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= alert %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
      <% end %>

      <%= yield %>
    </div>

    <footer class="text-center text-muted py-3 mt-5 border-top small">
      Mundial FIFA 2026 &mdash; Proyecto 4 POO &bull; TEC I Semestre 2026
    </footer>

    <!-- Bootstrap 5 JS (bundle incluye Popper) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
